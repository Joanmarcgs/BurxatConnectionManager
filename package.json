{
  "name": "burxats-connection-manager",
  "version": "0.1.0",
  "description": "Burxat's Connection Manager - a portable MobaXterm-style SSH/RDP/SFTP client",
  "main": "./out/main/index.js",
  "author": "you",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "dist:win": "powershell -ExecutionPolicy Bypass -File scripts/build-portable-win.ps1",
    "dist:win:nsis": "npm run build && electron-builder --win portable",
    "dist:linux": "npm run build && electron-builder --linux AppImage"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5",
    "ssh2": "^1.16.0",
    "@xterm/xterm": "^5.5.0",
    "@xterm/addon-fit": "^0.10.0",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@types/ssh2": "^1.15.1",
    "@types/uuid": "^9.0.8",
    "@types/node": "^20.14.15",
    "@vitejs/plugin-react": "^4.3.1",
    "electron": "^32.0.1",
    "electron-builder": "^24.13.3",
    "electron-vite": "^2.3.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.2"
  },
  "allowScripts": {
    "electron@32.3.3": true,
    "ssh2@1.17.0": true,
    "esbuild@0.21.5": true
  }
}
